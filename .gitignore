# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-a/
/.next-b/
/out/

# production
/build

# misc
.DS_Store
*.pem
.vscode_history_backup/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite & backups
*.db
*.db-journal
*.db-wal
*.db-shm
data/
/data/

# scratch pad files (personal notes, temp scripts)
/scratch/
scratch/

# foto mentah di luar kode (123 MB) dan izin lokal agen; .claude/launch.json tetap dilacak
/wisuda foto/
/.claude/settings.local.json
ChatGPT Image*.png

# compiled static theme demos (generated runtime cache)
/public/demo/*/index.html
public/demo/*/index.html

# server runtime logs
logs/
/logs/

# archive zip files
*.zip

# dynamic uploaded media (client uploads & moments)
/public/uploads/invitations/*
!/public/uploads/invitations/.gitkeep
/public/uploads/guest-memories/*
!/public/uploads/guest-memories/.gitkeep
/public/uploads/proofs/*
!/public/uploads/proofs/.gitkeep
/public/uploads/music/
/public/uploads/finance/
# media demo tema (foto, thumbnail, cache index.html): hasil turunan yang dibuat admin lewat Demo Studio, bukan isi repo
/public/demo/
# unggahan admin produksi (aset demo tema, logo/favicon); bawaan git tetap di public/assets/brand
/public/uploads/demo/
/public/uploads/brand/
# ornamen unggahan Theme Builder (nama hash isi; ditaut oleh master dan undangan terbit)
/public/uploads/theme-assets/
# font Google yang diunduh server saat admin memilihnya di Theme Builder (diunduh ulang otomatis bila hilang)
/public/uploads/fonts/

# published baked invitation HTML (konten klien — jangan commit ke repo)
/public/published/
public/published/

# portfolio HTML baked (full static clone klien)
/public/portfolio/assets/
public/portfolio/assets/

# Keluaran skrip QA (ditimpa tiap dijalankan)
/reports/
