generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String          @id @default(uuid())
  username     String          @unique
  email        String          @unique
  passwordHash String?
  name         String
  role         AdminRole       @default(SUPER_ADMIN)
  permissions  String[]        @default([])
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt
  auditLogs    AdminAuditLog[]

  @@map("admins")
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_audit_logs")
}

model User {
  id           String       @id @default(uuid())
  googleId     String?      @unique
  email        String       @unique
  name         String
  role         UserRole     @default(CLIENT)
  phoneNumber  String?
  avatarUrl    String?
  passwordHash String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
  invitations  Invitation[]
  orders       Order[]
  promoHolds   PromoHold[]

  @@map("users")
}

model Order {
  id                  String               @id @default(uuid())
  userId              String
  invoiceNumber       String               @unique
  planType            PlanType
  amount              Decimal              @db.Decimal(12, 2)
  status              OrderStatus          @default(PENDING)
  orderType           OrderType            @default(NEW)
  upgradedFromPlan    PlanType?
  targetPlanType      PlanType?
  linkedInvitationId  String?
  paymentMethod       PaymentMethod?       @default(GATEWAY)
  snapToken           String?
  proofImageUrl       String?
  proofUploadedAt     DateTime?
  rejectReason        String?
  paidAt              DateTime?
  fulfilledAt         DateTime?
  expiredAt           DateTime?
  checkoutConfirmedAt DateTime?
  promoCodeApplied    String?
  discountAmount      Decimal?             @db.Decimal(12, 2)
  promoCouponId       String?
  chargedAmount       Decimal?             @db.Decimal(12, 2)
  createdAt           DateTime             @default(now())
  gatewayId           String?
  gatewayTxId         String?
  requestedDomain     String?
  itemsJson           String?
  invitation          Invitation?          @relation("InvitationOrder")
  linkedInvitation    Invitation?          @relation("OrderLinkedInvitation", fields: [linkedInvitationId], references: [id], onDelete: SetNull)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCoupon         PromoCoupon?         @relation(fields: [promoCouponId], references: [id], onDelete: SetNull)
  promoHold           PromoHold?
  affiliateCommission AffiliateCommission?

  @@index([userId])
  @@index([status])
  @@index([gatewayId])
  @@index([promoCouponId])
  @@index([linkedInvitationId])
  @@map("orders")
}

model Invitation {
  id                   String            @id @default(uuid())
  orderId              String?           @unique
  userId               String
  themeId              String            @default("kalandra")
  eventType            EventType         @default(WEDDING)
  participantsJson     String?
  subdomain            String?           @unique
  customDomain         String?           @unique
  invitationSlug       String            @unique
  groomSlug            String
  brideSlug            String
  status               InvitationStatus  @default(DRAFT)
  publishedAt          DateTime?
  eventData            String?
  loveStory            String?
  bankAccounts         String?
  shippingAddress      String?
  featureSettings      String?
  staffPin             String?
  openingQuote         String?
  openingQuoteRef      String?
  dresscode            String?
  musicUrl             String?
  groomName            String?
  groomNickname        String?
  groomParents         String?
  groomFather          String?
  groomMother          String?
  groomInstagram       String?
  brideName            String?
  brideNickname        String?
  brideParents         String?
  brideFather          String?
  brideMother          String?
  brideInstagram       String?
  liveStreamUrl        String?
  isLockedPermanently  Boolean           @default(false)
  adminUnlockedUntil   DateTime?
  memoriesUploadLocked Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  galleryExpiresAt     DateTime?
  guestMemories        GuestMemory[]
  guests               Guest[]
  order                Order?            @relation("InvitationOrder", fields: [orderId], references: [id])
  linkedOrders         Order[]           @relation("OrderLinkedInvitation")
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme               Theme             @relation(fields: [themeId], references: [id], onDelete: Restrict)
  media                InvitationMedia[]
  rsvps                Rsvp[]

  @@index([userId])
  @@index([status])
  @@map("invitations")
}

model InvitationMedia {
  id           String     @id @default(uuid())
  invitationId String
  mediaSlot    MediaSlot
  localPath    String?
  mimeType     String?
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("media")
}

model Guest {
  id              String     @id @default(uuid())
  invitationId    String
  name            String
  slug            String
  category        String?
  phone           String?
  guestQuota      Int        @default(1)
  tableNumber     String?
  waStatus        WaStatus   @default(PENDING)
  qrToken        String?    @unique
  isTokenRedeemed Boolean    @default(false)

  sessionInfo     String?
  createdAt       DateTime   @default(now())
  invitation      Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  rsvps           Rsvp[]

  @@unique([invitationId, slug])
  @@index([invitationId])
  @@map("guests")
}

model Rsvp {
  id           String     @id @default(uuid())
  invitationId String
  guestId      String?
  guestName    String
  status       RsvpStatus
  guestCount   Int        @default(1)
  message      String?
  respondedAt  DateTime   @default(now())
  guest        Guest?     @relation(fields: [guestId], references: [id])
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([guestId])
  @@map("rsvps")
}

model GuestMemory {
  id           String     @id @default(uuid())
  invitationId String
  senderName   String
  senderEmail  String
  message      String?
  mediaType    String     @default("PHOTO")
  mediaUrl     String
  thumbnailUrl String?
  createdAt    DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("guest_memories")
}

model WebhookLog {
  id          String    @id @default(uuid())
  source      String
  event       String
  payload     Json
  status      String    @default("received")
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([source, createdAt])
  @@index([createdAt])
  @@map("webhook_logs")
}

model AdminSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  label     String?
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("admin_settings")
}

model Theme {
  id              String       @id
  name            String
  description     String?
  thumbnail       String?
  category        String       @default("minimalist")
  eventType       EventType    @default(WEDDING)
  parentTheme     String?
  series          String?
  isActive       Boolean      @default(true)
  sortOrder       Int          @default(0)
  defaultMusicUrl String?      @map("default_music_url")
  createdAt       DateTime     @default(now())
  invitations     Invitation[]

  @@map("themes")
}

model MusicPreset {
  id          String   @id @default(uuid())
  title       String
  composer    String?
  genre       String?
  url         String   @unique
  durationSec Int?     @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("music_presets")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  FINANCE
  SUPPORT
}

enum UserRole {
  CLIENT
  ADMIN
}

enum PlanType {
  TIER_1
  TIER_2
  TIER_3
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum PaymentMethod {
  GATEWAY
  MANUAL_TRANSFER
}

enum RsvpStatus {
  hadir
  tidak
  ragu
}

enum OrderType {
  NEW
  UPGRADE
  GALLERY_EXTENSION
  MEMORIES_TOPUP
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
  TAKEN_DOWN
  ARCHIVED
  EVENT_FINISHED
}

enum EventType {
  WEDDING
  BIRTHDAY
  KHITAN
  AQIQAH
  WISUDA
  GATHERING
}

enum WaStatus {
  PENDING
  SENT
}

enum MediaSlot {
  LANDING_COVER
  LANDING_COVER_DESKTOP
  HOME_PHOTO
  DESKTOP_SIDEBAR
  GLOBAL_FIXED_BG
  GROOM_PHOTO
  BRIDE_PHOTO
  GALLERY
  CLOSING_COVER
}

enum ExpenseCategory {
  INFRASTRUCTURE
  UTILITIES
  MARKETING
  SOFTWARE_LICENSES
  OPERATIONAL
  OTHER
}

model Expense {
  id              String          @id @default(uuid())
  title           String
  category        ExpenseCategory @default(OTHER)
  amount          Decimal         @db.Decimal(12, 2)
  expenseDate     DateTime        @default(now())
  paymentSource   String?         @default("TRANSFER_BANK")
  referenceNumber String?
  receiptUrl      String?
  notes           String?
  createdById     String?
  isLocked        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  commissions     AffiliateCommission[]

  @@index([category])
  @@index([expenseDate])
  @@map("expenses")
}

model RecurringExpense {
  id              String          @id @default(uuid())
  name            String
  category        ExpenseCategory @default(UTILITIES)
  estimatedAmount Decimal         @db.Decimal(12, 2)
  dueDayOfMonth   Int
  vendorName      String?
  paymentSource   String?         @default("TRANSFER_BANK")
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  @@map("recurring_expenses")
}

model FinancialClosing {
  id            String    @id @default(uuid())
  periodMonth   Int
  periodYear    Int
  grossRevenue  Decimal   @db.Decimal(12, 2)
  totalExpenses Decimal   @db.Decimal(12, 2)
  netProfit     Decimal   @db.Decimal(12, 2)
  taxAmount     Decimal   @db.Decimal(12, 2)
  taxPaid       Boolean   @default(false)
  taxPaidAt     DateTime?
  closedById    String
  closedAt      DateTime  @default(now())
  notes         String?

  @@unique([periodMonth, periodYear])
  @@map("financial_closings")
}

enum DiscountType {
  NOMINAL
  PERCENT
}

enum CommissionType {
  NOMINAL
  PERCENT
}

enum HoldStatus {
  HELD
  RELEASED
  CONSUMED
}

enum CommissionStatus {
  PENDING
  PAID
}

model PartnerAffiliate {
  id              String                @id @default(uuid())
  name            String
  phoneNumber     String?
  email           String?
  bankName        String?
  accountNumber   String?
  accountName     String?
  commissionType  CommissionType        @default(PERCENT)
  commissionValue Decimal               @db.Decimal(12, 2)
  pendingBalance  Decimal               @default(0) @db.Decimal(12, 2)
  totalPaidOut    Decimal               @default(0) @db.Decimal(12, 2)
  isActive        Boolean               @default(true)
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  coupons         PromoCoupon[]
  commissions     AffiliateCommission[]

  @@map("partner_affiliates")
}

model PromoCoupon {
  id                String            @id @default(uuid())
  code              String            @unique
  description       String?
  discountType      DiscountType      @default(NOMINAL)
  discountValue     Decimal           @db.Decimal(12, 2)
  minOrderAmount    Decimal           @default(0) @db.Decimal(12, 2)
  maxDiscountAmount Decimal?          @db.Decimal(12, 2)
  quotaLimit        Int?
  usageCount        Int               @default(0)
  perUserLimit     Int?              @default(1)
  applicablePlans   PlanType[]        @default([])
  validFrom         DateTime?
  validUntil        DateTime?
  isActive          Boolean           @default(true)
  partnerId         String?
  partner           PartnerAffiliate? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  holds             PromoHold[]
  orders            Order[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([partnerId])
  @@index([isActive])
  @@map("promo_coupons")
}

model PromoHold {
  id             String      @id @default(uuid())
  promoCode      String
  orderId        String      @unique
  userId         String
  status         HoldStatus  @default(HELD)
  discountAmount Decimal     @db.Decimal(12, 2)
  expiresAt      DateTime
  createdAt      DateTime    @default(now())
  coupon         PromoCoupon @relation(fields: [promoCode], references: [code], onDelete: Cascade)
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([promoCode, status])
  @@index([userId, promoCode, status])
  @@index([expiresAt])
  @@map("promo_holds")
}

model AffiliateCommission {
  id               String           @id @default(uuid())
  partnerId        String
  orderId          String           @unique
  orderAmount      Decimal          @db.Decimal(12, 2)
  commissionAmount Decimal          @db.Decimal(12, 2)
  status           CommissionStatus @default(PENDING)
  payoutExpenseId  String?
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  partner          PartnerAffiliate @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payoutExpense    Expense?         @relation(fields: [payoutExpenseId], references: [id], onDelete: SetNull)

  @@index([partnerId, status])
  @@index([payoutExpenseId])
  @@map("affiliate_commissions")
}


/// Tabel rate limiting cross-process berbasis PostgreSQL.
/// Digunakan oleh rateLimitDb() di lib/rateLimit.ts untuk endpoint publik sensitif
/// (RSVP, memories upload, scan resepsionis) di lingkungan PM2 multi-worker.
/// Tidak memerlukan cron cleanup — expired rows otomatis di-reset via UPSERT.
model RateLimitCounter {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@index([expiresAt], name: "idx_rate_limit_expires")
  @@map("rate_limit_counters")
}
