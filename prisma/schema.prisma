generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String          @id @default(uuid())
  username     String          @unique
  email        String          @unique
  passwordHash String?
  name         String
  role         AdminRole       @default(SUPER_ADMIN)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt
  auditLogs    AdminAuditLog[]

  @@map("admins")
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_audit_logs")
}

model User {
  id          String       @id @default(uuid())
  googleId    String?      @unique
  email       String       @unique
  name        String
  role        UserRole     @default(CLIENT)
  phoneNumber String?
  avatarUrl   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  invitations Invitation[]
  orders      Order[]

  @@map("users")
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  invoiceNumber     String      @unique
  planType          PlanType
  amount            Decimal
  status            OrderStatus @default(PENDING)
  orderType         OrderType   @default(NEW)
  upgradedFromPlan  PlanType?
  targetPlanType    PlanType?
  linkedOrderId     String?
  paymentMethod     String?     @default("GATEWAY")
  paymentGatewayRef String?
  snapToken         String?
  proofImageUrl     String?
  proofUploadedAt   DateTime?
  rejectReason      String?
  paidAt            DateTime?
  expiredAt         DateTime?
  createdAt         DateTime    @default(now())
  gatewayId         String?
  gatewayTxId       String?
  requestedDomain   String?
  invitation        Invitation?
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([gatewayId])
  @@map("orders")
}

model Invitation {
  id                   String            @id @default(uuid())
  orderId              String?           @unique
  userId               String
  themeId              String            @default("kila")
  subdomain            String?           @unique
  customDomain         String?           @unique
  invitationSlug       String            @unique
  groomSlug            String
  brideSlug            String
  status               InvitationStatus  @default(DRAFT)
  publishedAt          DateTime?
  expiresAt            DateTime?
  eventData            String?
  loveStory            String?
  bankAccounts         String?
  shippingAddress      String?
  featureSettings      String?
  staffPin             String?
  openingQuote         String?
  openingQuoteRef      String?
  dresscode            String?
  musicUrl             String?
  groomName            String?
  groomNickname        String?
  groomParents         String?
  groomInstagram       String?
  brideName            String?
  brideNickname        String?
  brideParents         String?
  brideInstagram       String?
  liveStreamUrl        String?
  isLockedPermanently  Boolean           @default(false)
  adminUnlockedUntil   DateTime?
  memoriesUploadLocked Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  galleryExpiresAt     DateTime?
  guestMemories        GuestMemory[]
  guests               Guest[]
  order                Order?            @relation(fields: [orderId], references: [id])
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  media                InvitationMedia[]
  rsvps                Rsvp[]
  wishes               Wish[]

  @@index([userId])
  @@index([status])
  @@map("invitations")
}

model InvitationMedia {
  id           String     @id @default(uuid())
  invitationId String
  mediaSlot    MediaSlot
  localPath    String?
  mimeType     String?
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("media")
}

model Guest {
  id              String     @id @default(uuid())
  invitationId    String
  name            String
  slug            String
  category        String?
  phone           String?
  guestQuota      Int        @default(1)
  tableNumber     String?
  waStatus        WaStatus   @default(PENDING)
  waSentAt        DateTime?
  qrToken         String?    @unique
  isTokenRedeemed Boolean    @default(false)
  videoWishUrl    String?
  videoRecordedAt DateTime?
  sessionInfo     String?
  createdAt       DateTime   @default(now())
  invitation      Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  rsvps           Rsvp[]

  @@unique([invitationId, slug])
  @@index([invitationId])
  @@map("guests")
}

model Rsvp {
  id           String     @id @default(uuid())
  invitationId String
  guestId      String?
  guestName    String
  status       String
  guestCount   Int        @default(1)
  message      String?
  respondedAt  DateTime   @default(now())
  guest        Guest?     @relation(fields: [guestId], references: [id])
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("rsvps")
}

model Wish {
  id           String     @id @default(uuid())
  invitationId String
  senderName   String
  message      String
  createdAt    DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("wishes")
}

model GuestMemory {
  id           String     @id @default(uuid())
  invitationId String
  senderName   String
  senderEmail  String
  message      String?
  mediaType    String     @default("PHOTO")
  mediaUrl     String
  thumbnailUrl String?
  createdAt    DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("guest_memories")
}

model WebhookLog {
  id          String    @id @default(uuid())
  source      String
  event       String
  payload     Json
  status      String    @default("received")
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("webhook_logs")
}

model AdminSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  label     String?
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("admin_settings")
}

model Theme {
  id          String   @id
  name        String
  description String?
  thumbnail   String?
  category    String   @default("luxury")
  series      String?
  previewUrl  String?
  isPremium   Boolean  @default(false)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  price       Decimal  @default(0)
  createdAt   DateTime @default(now())

  @@map("themes")
}

model MusicPreset {
  id          String   @id @default(uuid())
  title       String
  composer    String?
  genre       String?
  url         String   @unique
  durationSec Int?     @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("music_presets")
}

enum AdminRole {
  SUPER_ADMIN
  FINANCE
  SUPPORT
}

enum UserRole {
  CLIENT
  ADMIN
}

enum PlanType {
  TRADITIONAL
  MODERN
  PREMIUM
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum OrderType {
  NEW
  UPGRADE
  GALLERY_EXTENSION
  CUSTOM_DOMAIN_ADDON
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
  TAKEN_DOWN
  ARCHIVED
  EVENT_FINISHED
}

enum WaStatus {
  PENDING
  SENT
}

enum MediaSlot {
  LANDING_COVER
  HOME_PHOTO
  DESKTOP_SIDEBAR
  GLOBAL_FIXED_BG
  GROOM_PHOTO
  BRIDE_PHOTO
  GALLERY
  CLOSING_COVER
}
