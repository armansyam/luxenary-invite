// S-Invite — Prisma Schema (SQLite)
// Self-service invitation platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================================
// 1. ADMINS (Khusus Tim Manajemen & Staff Luxenary)
// ============================================================
model Admin {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String?
  name         String
  role         AdminRole @default(SUPER_ADMIN) // SUPER_ADMIN | FINANCE | SUPPORT
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  auditLogs AdminAuditLog[]

  @@map("admins")
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String // e.g. "APPROVE_ORDER", "UPDATE_SETTINGS", "LOGIN"
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_audit_logs")
}

// ============================================================
// 2. USERS / CLIENTS (Calon Pengantin / Akun Klien)
// ============================================================
model User {
  id          String   @id @default(uuid())
  googleId    String?  @unique
  email       String   @unique
  name        String
  role        UserRole @default(CLIENT)
  phoneNumber String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  orders      Order[]
  invitations Invitation[]

  @@map("users")
}

// ============================================================
// 3. ORDERS (Transaksi Pembelian Paket)
// ============================================================
model Order {
  id                String      @id @default(uuid())
  userId            String
  invoiceNumber     String      @unique
  planType          PlanType
  amount            Decimal
  status            OrderStatus @default(PENDING)
  orderType         OrderType   @default(NEW) // NEW | UPGRADE
  upgradedFromPlan  PlanType? // Tier asal sebelum upgrade (null jika NEW)
  targetPlanType    PlanType? // Tier tujuan upgrade (null jika NEW)
  linkedOrderId     String? // ID order lama yang di-upgrade
  paymentMethod     String?     @default("GATEWAY") // GATEWAY | MANUAL_TRANSFER
  paymentGatewayRef String?
  snapToken         String?
  proofImageUrl     String?
  proofUploadedAt   DateTime?
  rejectReason      String?
  paidAt            DateTime?
  expiredAt         DateTime?
  createdAt         DateTime    @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation Invitation?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

// ============================================================
// 4. INVITATIONS (Data Utama Undangan)
// ============================================================
model Invitation {
  id                  String           @id @default(uuid())
  orderId             String?          @unique
  userId              String
  themeId             String           @default("kila") // kila | aruna | ivanna | danila | papercut
  subdomain           String?          @unique
  customDomain        String?          @unique
  invitationSlug      String           @unique // Flat canonical slug: arman-siti-030326[-jakarta]
  groomSlug           String // 'arman'
  brideSlug           String // 'siti'
  status              InvitationStatus @default(DRAFT)
  publishedAt         DateTime?
  expiresAt           DateTime?
  eventData           String? // Dynamic JSON Multi-Event Array
  loveStory           String? // Dynamic JSON Love Story Chapters Array
  bankAccounts        String? // Dynamic JSON Bank Accounts Array
  shippingAddress     String? // Physical Gift Shipping Address
  featureSettings     String? // Dynamic JSON Feature Settings & Color Palette
  staffPin            String? // Keamanan untuk Scanner & Layar Proyektor (Hashed in DB)
  openingQuote        String? // Opening Quote Text
  openingQuoteRef     String? // Opening Quote Reference (e.g. QS. Ar-Rum : 21)
  dresscode           String?
  musicUrl            String?
  groomName           String?
  groomNickname       String?
  groomParents        String?
  groomInstagram      String?
  brideName           String?
  brideNickname       String?
  brideParents        String?
  brideInstagram      String?
  liveStreamUrl       String?
  isLockedPermanently Boolean          @default(false)
  adminUnlockedUntil  DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  order         Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  media         InvitationMedia[]
  guests        Guest[]
  rsvps         Rsvp[]
  wishes        Wish[]
  guestMemories GuestMemory[]

  @@index([userId])
  @@index([status])
  @@map("invitations")
}

// ============================================================
// 5. INVITATION MEDIA (Foto, Video, Audio)
// ============================================================
model InvitationMedia {
  id           String    @id @default(uuid())
  invitationId String
  mediaSlot    MediaSlot
  localPath    String?   // URL R2 (produksi) atau path lokal (development)
  mimeType     String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("media")
}

// ============================================================
// 6. GUESTS (Daftar Tamu & Kuota)
// ============================================================
model Guest {
  id              String    @id @default(uuid())
  invitationId    String
  name            String
  slug            String // URL-safe version of name: 'budi-santoso'
  category        String? // VVIP | VIP | Keluarga | Teman Kantor | Umum
  phone           String?
  phoneNumber     String?
  guestQuota      Int       @default(1)
  tableNumber     String?
  waStatus        WaStatus  @default(PENDING)
  waSentAt        DateTime?
  qrToken         String?   @unique
  isTokenRedeemed Boolean   @default(false)
  videoWishUrl    String?
  videoRecordedAt DateTime?
  sessionInfo     String?
  createdAt       DateTime  @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  rsvps      Rsvp[]

  @@unique([invitationId, slug])
  @@index([invitationId])
  @@map("guests")
}

// ============================================================
// 7. RSVPs (Konfirmasi Kehadiran)
// ============================================================
model Rsvp {
  id           String   @id @default(uuid())
  invitationId String
  guestId      String?
  guestName    String
  status       String // hadir | tidak | ragu
  guestCount   Int      @default(1)
  message      String?
  respondedAt  DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([invitationId])
  @@map("rsvps")
}

// ============================================================
// 8. WISHES (Ucapan & Doa Tamu)
// ============================================================
model Wish {
  id           String   @id @default(uuid())
  invitationId String
  senderName   String
  message      String
  createdAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("wishes")
}

// ============================================================
// 8B. GUEST MEMORIES (Foto & Video Kenangan Tamu Pasca-Acara)
// ============================================================
model GuestMemory {
  id           String   @id @default(uuid())
  invitationId String
  senderName   String
  senderEmail  String
  message      String?
  mediaType    String   @default("PHOTO") // "PHOTO" | "VIDEO"
  mediaUrl     String   // URL R2 (produksi) atau path lokal (development)
  thumbnailUrl String?
  createdAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("guest_memories")
}

// ============================================================
// 10. WEBHOOK LOGS
// ============================================================
model WebhookLog {
  id          String    @id @default(uuid())
  source      String // midtrans | ipaymu | xendit | whatsapp
  event       String // payment.success | read.receipt
  payload     Json
  status      String    @default("received") // received | processed | failed
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("webhook_logs")
}

// ============================================================
// 11. ADMIN SETTINGS
// ============================================================
model AdminSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  label     String?
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("admin_settings")
}

// ============================================================
// 12. THEMES
// ============================================================
model Theme {
  id          String   @id // 'kila', 'aruna', 'ivanna', 'danila', 'papercut'
  name        String
  description String?
  thumbnail   String?
  category    String   @default("luxury")
  series      String?
  previewUrl  String?
  isPremium   Boolean  @default(false)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  price       Decimal  @default(0)
  createdAt   DateTime @default(now())

  @@map("themes")
}

// ============================================================
// ENUMS
// ============================================================
enum AdminRole {
  SUPER_ADMIN
  FINANCE
  SUPPORT
}

enum UserRole {
  CLIENT
  ADMIN
}

enum PlanType {
  TRADITIONAL
  MODERN
  PREMIUM
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum OrderType {
  NEW
  UPGRADE
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
  TAKEN_DOWN
  ARCHIVED
}

enum WaStatus {
  PENDING
  SENT
  READ
}

enum MediaSlot {
  LANDING_COVER
  HOME_PHOTO
  DESKTOP_SIDEBAR
  GLOBAL_FIXED_BG
  GROOM_PHOTO
  BRIDE_PHOTO
  GALLERY
  CLOSING_COVER
}
