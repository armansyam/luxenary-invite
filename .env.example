# ==============================================================================
# LUXENARY INVITE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# File `.env` ini secara spesifik hanya memuat konfigurasi dasar peladen (server),
# koneksi database, dan kunci keamanan (secret). 
# 
# PENTING: Sebagian besar konfigurasi dinamis (seperti Nama Brand, Logo, Harga) 
# dikelola secara langsung melalui Dashboard Admin (/admin).
# Namun, untuk Kredensial Google OAuth WAJIB diisi di file .env ini demi stabilitas
# inisialisasi sesi NextAuth di lingkungan Edge & Server Components.
# dan tersimpan di database agar lebih fleksibel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Contoh koneksi PostgreSQL lokal: postgresql://username:password@localhost:5432/luxenary?schema=public&connection_limit=30
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/luxenary?schema=public&connection_limit=30"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH SECURITY & ROUTING
# ------------------------------------------------------------------------------
# NEXTAUTH_SECRET wajib ada. Jika Anda men-deploy menggunakan deploy.sh,
# kunci ini akan di-generate secara otomatis.
NEXTAUTH_SECRET=""
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2B. GOOGLE OAUTH CREDENTIALS
# ------------------------------------------------------------------------------
# Buat di https://console.cloud.google.com/apis/credentials
# Pilih "OAuth client ID" > "Web application"
# 
# PENTING: Anda WAJIB mengisi 2 URL berikut di Google Console:
# 
# 1) Authorized JavaScript origins:
#    - Lokal: http://localhost:3000
#    - Production: https://domainanda.com
# 
# 2) Authorized redirect URIs:
#    - Lokal: http://localhost:3000/api/auth/callback/google
#    - Production: https://domainanda.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 2C. PIN ENCRYPTION KEY (WAJIB diisi untuk keamanan staffPin resepsionis)
# ------------------------------------------------------------------------------
# Generate dengan perintah: openssl rand -hex 32
# JANGAN gunakan key yang sama di development dan production
# JANGAN commit key ini ke git
PIN_ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# 2D. CRON JOB SECRET
# ------------------------------------------------------------------------------
# Digunakan untuk mengamankan endpoint POST /api/cron/cleanup
# Generate dengan perintah: openssl rand -hex 32
CRON_SECRET=""


# Domain utama aplikasi (untuk keperluan routing Wildcard Subdomain)
# Contoh: luxenary.id (tanpa https:// atau path)
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# URL lengkap aplikasi (wajib pakai protokol http/https)
# Contoh: https://luxenary.id
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NODE_ENV="production"

# ------------------------------------------------------------------------------
# 3. CLOUD STORAGE SETTINGS
# ------------------------------------------------------------------------------
# Pilihan: 'local', 'r2', atau 's3'
STORAGE_PROVIDER="local"

# Kredensial di bawah ini HANYA wajib diisi jika STORAGE_PROVIDER bernilai 'r2' atau 's3'
S3_ENDPOINT=""
S3_BUCKET_NAME=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""
# Opsional: Jika Anda menggunakan domain khusus untuk R2/S3 (contoh: cdn.domain.com)
S3_CUSTOM_DOMAIN=""

# ------------------------------------------------------------------------------
# 4. GOOGLE DRIVE API INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Kunci API Google Cloud (bukan OAuth) untuk mengambil foto galeri pre-wedding 
GOOGLE_API_KEY=""
