# ==============================================================================
# LUXENARY INVITE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# File `.env` ini secara spesifik memuat konfigurasi dasar peladen (server),
# koneksi database, domain, dan kunci keamanan (secret).
# 
# PANDUAN PENTING:
# 1. Konfigurasi dinamis (Nama Brand, Logo, Rekening Bank, Midtrans/Tripay/Duitku/Xendit)
#    dikelola secara langsung & fleksibel melalui Dashboard Admin (/admin).
# 2. Jika Anda men-deploy menggunakan script `./deploy.sh`, kunci rahasia
#    (AUTH_SECRET, NEXTAUTH_SECRET, CRON_SECRET, PIN_ENCRYPTION_KEY) 
#    akan di-generate secara otomatis!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Format URL: postgresql://[user]:[password]@[host]:[port]/[database_name]?schema=public&connection_limit=10
# 
# Cara Menyiapkan di VPS Ubuntu:
# 1) Masuk psql: sudo -u postgres psql
# 2) Buat database: CREATE DATABASE luxenary;
# 3) Buat user: CREATE USER lux_user WITH ENCRYPTED PASSWORD 'password_rahasia_anda';
# 4) Beri hak akses: GRANT ALL PRIVILEGES ON DATABASE luxenary TO lux_user;
# 5) Ubah string koneksi di bawah ini sesuai password yang Anda buat.
# 
# CATATAN PERFORMA (VPS 2 Core / 2 GB RAM):
# Gunakan connection_limit=10 agar PostgreSQL tidak memakan terlalu banyak RAM.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/luxenary?schema=public&connection_limit=10"


# ------------------------------------------------------------------------------
# 2. NEXTAUTH SECURITY & APPLICATION URL
# ------------------------------------------------------------------------------
# NEXTAUTH_SECRET & AUTH_SECRET:
# Kunci enkripsi sesi login cookie admin & klien.
# Cara Generate Manual: Jalankan perintah berikut di terminal:
#   openssl rand -base64 32
# (Otomatis dibuatkan jika Anda menjalankan ./deploy.sh)
AUTH_SECRET=""
NEXTAUTH_SECRET=""

# NEXTAUTH_URL:
# URL lengkap website Anda (Wajib diawali https:// di VPS Production)
# - Lokal: http://localhost:3000
# - Production: https://domainanda.com
NEXTAUTH_URL="http://localhost:3000"

# NEXT_PUBLIC_ROOT_DOMAIN:
# Domain utama aplikasi TANPA https:// dan TANPA path.
# Digunakan oleh sistem middleware untuk mengenali Wildcard Subdomain klien (namapasangan.domainanda.com).
# - Lokal: localhost:3000
# - Production: domainanda.com (contoh: luxenary.id)
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# NEXT_PUBLIC_APP_URL:
# URL lengkap publik aplikasi Anda (Sama dengan NEXTAUTH_URL).
# - Lokal: http://localhost:3000
# - Production: https://domainanda.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NODE_ENV="production"


# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH CREDENTIALS (LOGIN DENGAN GOOGLE)
# ------------------------------------------------------------------------------
# Diperlukan untuk tombol "Masuk dengan Google" pada portal klien & admin.
# 
# Langkah-langkah Mendapatkan Client ID & Secret:
# 1) Buka Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2) Buat Project baru atau pilih project yang sudah ada.
# 3) Buka menu "APIs & Services" > "OAuth consent screen" (Pilih External, isi nama aplikasi).
# 4) Buka menu "Credentials" > Klik "Create Credentials" > Pilih "OAuth client ID".
# 5) Application type: Pilih "Web application".
# 6) Pada bagian "Authorized JavaScript origins", tambahkan:
#    - http://localhost:3000 (untuk lokal)
#    - https://domainanda.com (untuk production)
# 7) Pada bagian "Authorized redirect URIs", tambahkan:
#    - http://localhost:3000/api/auth/callback/google (untuk lokal)
#    - https://domainanda.com/api/auth/callback/google (untuk production)
# 8) Klik "Create" lalu salin Client ID & Client Secret ke bawah ini:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ------------------------------------------------------------------------------
# 4. KUNCI KEAMANAN ENKRIPSI & CRON JOB
# ------------------------------------------------------------------------------
# PIN_ENCRYPTION_KEY:
# Kunci enkripsi AES-256 untuk mengamankan staffPin resepsionis tamu di database.
# Cara Generate: Jalankan perintah berikut di terminal:
#   openssl rand -hex 32
# (Otomatis dibuatkan jika Anda menjalankan ./deploy.sh)
PIN_ENCRYPTION_KEY=""

# CRON_SECRET:
# Token otentikasi untuk mengamankan endpoint cron otomatis:
# - POST /api/cron/cleanup (Pembersihan data expired)
# - POST /api/cron/backup  (Pencadangan database otomatis)
# Cara Generate: Jalankan perintah berikut di terminal:
#   openssl rand -hex 32
# (Otomatis dibuatkan jika Anda menjalankan ./deploy.sh)
CRON_SECRET=""


# ------------------------------------------------------------------------------
# 5. CLOUD STORAGE SETTINGS (FOTO, VIDEO & AUDIO)
# ------------------------------------------------------------------------------
# Pilihan penyedia penyimpanan: 'local', 'r2', atau 's3'
# - 'local' : Menyimpan file di disk VPS folder public/uploads/ (Praktis, gratis, tanpa setup cloud).
# - 'r2'    : Cloudflare R2 Object Storage (Sangat Direkomendasikan: Murah, bebas biaya bandwidth egress).
# - 's3'    : Amazon Web Services S3.
STORAGE_PROVIDER="local"

# Kredensial di bawah ini HANYA wajib diisi jika STORAGE_PROVIDER bernilai 'r2' atau 's3'
# Cara Membuat Cloudflare R2:
# 1) Buka Cloudflare Dashboard > R2 Object Storage > Create Bucket (misal: luxenary-storage).
# 2) Di tab Settings Bucket, hubungkan "Custom Domain" (misal: cdn.domainanda.com) atau aktifkan "R2.dev Subdomain".
# 3) Buka menu "Manage R2 API Tokens" > Create API Token (Permissions: Object Read & Write).
# 4) Salin Endpoint, Access Key ID, dan Secret Access Key ke konfigurasi di bawah:
S3_ENDPOINT=""
S3_BUCKET_NAME=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""
S3_CUSTOM_DOMAIN=""


# ------------------------------------------------------------------------------
# 6. GOOGLE DRIVE API INTEGRATION (OPSIONAL - GALERI MOMEN)
# ------------------------------------------------------------------------------
# Digunakan jika pengantin ingin menghubungkan folder Google Drive publik untuk
# menyedot foto prewedding secara realtime ke dalam galeri undangan.
# 
# Cara Mendapatkan Google API Key:
# 1) Di Google Cloud Console (https://console.cloud.google.com/apis/library), cari dan aktifkan "Google Drive API".
# 2) Buka menu "Credentials" > Klik "Create Credentials" > Pilih "API key".
# 3) Salin API key yang dihasilkan ke bawah ini:
GOOGLE_API_KEY=""


# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAY (MIDTRANS, TRIPAY, DUITKU, XENDIT, IPAYMU)
# ------------------------------------------------------------------------------
# CATATAN: Seluruh kredensial Payment Gateway diatur secara fleksibel & dinamis
# langsung melalui halaman Web Admin (/admin > Settings > Payment Gateway).
# Anda TIDAK PERLU memasukkan API Key payment gateway di file .env ini.
# ==============================================================================
