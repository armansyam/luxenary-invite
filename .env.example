# ==============================================================================
# LUXENARY INVITE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env` lalu isi dengan nilai yang sesuai.
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SQLite)
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH / AUTH.JS CONFIGURATION
# ------------------------------------------------------------------------------
# Generate secret baru dengan command: openssl rand -base64 32
AUTH_SECRET="your_nextauth_super_secret_32_characters_key_here"
NEXTAUTH_SECRET="your_nextauth_super_secret_32_characters_key_here"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH CREDENTIALS (Untuk Login Google Pengantin)
# ------------------------------------------------------------------------------
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Redirect URI: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# ------------------------------------------------------------------------------
# 4. IPAYMU PAYMENT GATEWAY (Payment Gateway Utama)
# ------------------------------------------------------------------------------
# Catatan: Nilai ini juga dapat dikonfigurasi langsung dari Portal Admin (/admin) -> Pengaturan
# Dapatkan dari Dashboard iPaymu -> Integrasi API
IPAYMU_VA="0000000000000000"
IPAYMU_API_KEY="your_ipaymu_api_key_here"
# Set "true" untuk Sandbox (testing), atau "false" untuk Mode Produksi (live payment)
IPAYMU_SANDBOX="true"

# ------------------------------------------------------------------------------
# 5. PLATFORM / APP URL
# ------------------------------------------------------------------------------
# Gunakan URL publik (contoh: https://luxenary.id atau ngrok URL saat testing webhook lokal)
APP_URL="http://localhost:3000"
BASE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 6. MIDTRANS PAYMENT GATEWAY (Opsional / Backup)
# ------------------------------------------------------------------------------
MIDTRANS_SERVER_KEY="your_midtrans_server_key_here"
