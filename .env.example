# ==============================================================================
# LUXENARY INVITE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# File `.env` hanya memuat konfigurasi dasar server dan enkripsi session.
# Seluruh konfigurasi dinamis (Nama Brand, Logo, Harga Paket, Google OAuth, 
# Payment Gateway iPaymu, Auto-Backup Database, dsb.) dikelola langsung 
# melalui Dashboard Admin (/admin -> Pengaturan) dan tersimpan di database.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SQLite)
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH SESSION ENCRYPTION
# ------------------------------------------------------------------------------
# Generate secret baru dengan command: openssl rand -base64 32
AUTH_SECRET="your_nextauth_super_secret_32_characters_key_here"
NEXTAUTH_SECRET="your_nextauth_super_secret_32_characters_key_here"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT MODE
# ------------------------------------------------------------------------------
NODE_ENV="development"
